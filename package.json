{
  "name": "dsh-notify-on-done",
  "version": "0.1.1",
  "private": true,
  "description": "dsh 网页端：对话完成 / 需要你确认时弹出系统通知（浏览器桌面通知 + 站内兜底）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "web"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "mqnu00",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mqnu00/dsh-notify-on-done.git"
  },
  "homepage": "https://github.com/mqnu00/dsh-notify-on-done#readme",
  "bugs": {
    "url": "https://github.com/mqnu00/dsh-notify-on-done/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "*"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT"
}
